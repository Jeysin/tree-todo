{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tree Todo",
  "version": "2.0.0",
  "identifier": "com.jeysin.treetodo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBRDE4MjBFMDRDNjlDREUKUldUZW5NWUVEb0xSK29USmJYUmw2ZkFhSStzRDh0dXU2STVZL0xUeXJTeVBmRTBxZDh3dTdIZWcK",
      "endpoints": [
        "https://github.com/Jeysin/tree-todo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
